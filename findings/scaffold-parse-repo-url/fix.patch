@@ -43,12 +43,27 @@ export function parseRepoUrl(url?: string): {
   owner: string;
   repo: string;
 } {
-  if (!url)
-    throw new Error("Parse repository URL failed.");
+  if (!url) {
+    throw new Error(
+      "Parse repository URL failed: package.json#repository.url is not set.",
+    );
+  }
 
-  const match = (url).match(/:\/\/.+com\/([^/]+)\/([^.]+)\.git$/);
+  // Accept https/git+https/ssh URLs and scp-like `git@host:owner/repo` remotes,
