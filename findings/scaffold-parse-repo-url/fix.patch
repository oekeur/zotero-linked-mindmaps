+  // not silently mis-parse -- it fails and is reported.
+  const normalized = url
+    .replace(/^[a-z][a-z0-9+.-]*:\/\//i, "")
+    .replace(/^[^/@]+@/, "")
+    .replace(":", "/");
+  const match = normalized.match(/^[^/]+\/([^/]+)\/([^/]+?)(?:\.git)?\/?$/);
   if (!match) {
-    throw new Error("Parse repository URL failed.");
+    throw new Error(
+      `Parse repository URL failed: could not read owner and repo from `
