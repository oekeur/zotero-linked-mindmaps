{
  "name": "zotero-linked-mindmaps",
  "type": "module",
  "version": "0.1.0",
  "description": "Zotero 7 plugin for typed, named links between items and notes, organized into multiple named mindmaps.",
  "config": {
    "addonName": "Zotero Linked Mindmaps",
    "addonID": "zoterolinkedmindmaps@example.com",
    "addonRef": "zoterolinkedmindmaps",
    "addonInstance": "ZoteroLinkedMindmaps",
    "prefsPrefix": "extensions.zotero.zoterolinkedmindmaps"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oscarkeur/zotero-linked-mindmaps.git"
  },
  "homepage": "https://github.com/oscarkeur/zotero-linked-mindmaps",
  "author": "Oscar Keur",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "clean:profile": "node scripts/clean-dev-profile.mjs",
    "prestart": "node scripts/clean-dev-profile.mjs",
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "cytoscape": "^3.34.1",
    "zotero-plugin-toolkit": "5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/cytoscape": "^3.21.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "private": true
}
